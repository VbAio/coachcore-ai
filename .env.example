# Copy to .env and fill in values

# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------
LOCAL_DEV=true
DATABASE_URL="file:./prisma/dev.db"
# Production Neon example:
# DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"

REDIS_URL="redis://localhost:6379"
# Required in production when LOCAL_DEV=false (Railway Redis plugin URL)

# Auth.js — generate secret: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: https://coachcore-ai-web.vercel.app (no trailing slash, no extra /.vercel.app)

# OAuth — Auth.js standard names (preferred)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Legacy aliases (also supported)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google redirect URI to register in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/google
# Discord redirect URI to register in Discord Developer Portal:
#   http://localhost:3000/api/auth/callback/discord
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/discord

# Email (Resend) — REQUIRED on Vercel/production or "Resend email" will fail
# 1) https://resend.com → API Keys → create key (re_...)
# 2) For a quick test use Resend's sandbox from-address (only delivers to YOUR Resend login email):
#      EMAIL_FROM="CoachCore AI <onboarding@resend.dev>"
#    For real inboxes: Domains → verify your domain → use noreply@yourdomain.com
# 3) Add both vars on Vercel → Settings → Environment Variables → Production, then Redeploy
RESEND_API_KEY=
EMAIL_FROM="CoachCore AI <onboarding@resend.dev>"
# AUTH_URL / NEXT_PUBLIC_APP_URL must be your public site origin so verify links work.

# -----------------------------------------------------------------------------
# Replay file storage
# -----------------------------------------------------------------------------
# local = disk under apps/api/uploads (dev only)
# s3    = AWS S3 or S3-compatible (Cloudflare R2) — required for worldwide deploys
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=coachcore-replays
# Cloudflare R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Set AI_COACH_PROVIDER=openai and OPENAI_API_KEY to merge LLM coaching into reports.
# Without a key, reports still generate from parsed .dem events via the rule engine.
OPENAI_API_KEY=
AI_COACH_PROVIDER=mock

API_PORT=4000
# Railway injects PORT automatically; API_PORT is the local fallback
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# Comma-separated origins allowed by the API (include Vercel URL in production)
CORS_ORIGIN=http://localhost:3000

LEADERBOARD_API_URL=https://api.deadlock-api.com
LEADERBOARD_API_KEY=
# Optional — Statlocker ranked board works without a key via the public site endpoint.
# If you have an approved key from https://statlocker.gg/api, set it here.
STATLOCKER_API_URL=https://statlocker.gg
STATLOCKER_API_KEY=
MAX_REPLAY_SIZE_MB=1500
REPLAY_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Production checklist (worldwide uploads)
# -----------------------------------------------------------------------------
# Railway API service:
#   LOCAL_DEV=false
#   DATABASE_URL=<Neon>
#   REDIS_URL=<Railway Redis>
#   STORAGE_PROVIDER=s3
#   AWS_* / S3_BUCKET / S3_ENDPOINT
#   CORS_ORIGIN=https://coachcore-ai-web.vercel.app
#   AI_COACH_PROVIDER / OPENAI_API_KEY (optional)
#
# Vercel web project:
#   NEXT_PUBLIC_API_URL=https://<your-railway-api>.up.railway.app
#   NEXT_PUBLIC_WS_URL=wss://<your-railway-api>.up.railway.app
#   AUTH_URL / NEXT_PUBLIC_APP_URL=https://coachcore-ai-web.vercel.app
#   DATABASE_URL / AUTH_* / OAuth secrets (same Neon + providers)
