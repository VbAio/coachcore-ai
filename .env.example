# Copy to .env and fill in values

# Local dev (SQLite, no Docker)
LOCAL_DEV=true
DATABASE_URL="file:./prisma/dev.db"

# Production (PostgreSQL)
# DATABASE_URL="postgresql://coachcore:coachcore@localhost:5432/coachcore?schema=public"

REDIS_URL="redis://localhost:6379"

# Auth.js — generate secret: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth — Auth.js standard names (preferred)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Legacy aliases (also supported)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google redirect URI to register in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/google
# Discord redirect URI to register in Discord Developer Portal:
#   http://localhost:3000/api/auth/callback/discord
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/discord

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="CoachCore AI <noreply@coachcore.ai>"

STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=coachcore-replays
S3_ENDPOINT=

OPENAI_API_KEY=
AI_COACH_PROVIDER=mock

API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
CORS_ORIGIN=http://localhost:3000

LEADERBOARD_API_URL=https://api.deadlock-api.com
LEADERBOARD_API_KEY=
MAX_REPLAY_SIZE_MB=500
REPLAY_RETENTION_DAYS=30
